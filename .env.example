# BIG MOV server configuration
# Never commit real credentials. Keep DATABASE_URL server-side only.

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full&options=--cluster%3DCLUSTER_NAME"

TMDB_API_KEY=""

# Public VidSrc embed endpoints used by the BIG MOV player.
VIDSRC_BASE_URL="https://vidsrc.tw/embed"
VIDSRC_FALLBACK_BASE_URL="https://vidsrc.ir/embed"
VIDSRC_TOKEN=""
